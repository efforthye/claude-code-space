# Mayo API configuration — copy to .env and fill locally. NEVER commit real
# secret values (see repo CLAUDE.md security rule). This file lists names only.

# dev | prod
MAYO_ENV=dev

# local | s3  (ADR 0004 — local first, s3 later)
MAYO_STORAGE_BACKEND=local
MAYO_STORAGE_LOCAL_PATH=./media

# CORS: comma-separated origins for the Expo app / mayo.im web. "*" ok in dev.
MAYO_ALLOWED_ORIGINS=*

# Shared API key required on all /v1/* endpoints. REQUIRED when the API is
# publicly reachable (e.g. via the Cloudflare tunnel). Generate a random value,
# e.g.  openssl rand -hex 32  — put the SAME value in the app (Account -> API key,
# or EXPO_PUBLIC_MAYO_API_KEY). Never commit the value.
MAYO_API_KEY=<in host .env / secret store>

# Mock generation cadence (seconds per scene tick). Lower = faster demo.
MAYO_TICK_SECONDS=1.0

# Generation backend: mock (built-in timed stand-in) | external (real providers).
MAYO_GENERATION_BACKEND=mock

# Scenario planner / "AI director" (ADR 0008): mock | claude | local
#   mock  = free, offline, rule-based stand-in (no real AI) — default
#   local = free, real AI via a local LLM (Ollama) — no paid key, see below
#   claude= best quality, needs a paid ANTHROPIC_API_KEY
MAYO_PLANNER_BACKEND=mock
# Director LLM when planner=claude (an id from GET /v1/catalog/directors)
MAYO_DIRECTOR_MODEL=claude-opus-4-8
# Claude credentials for the director (value at runtime; never commit)
# ANTHROPIC_API_KEY=<in host .env / secret store>   # or use `ant auth login`

# Local LLM director (used when MAYO_PLANNER_BACKEND=local) — free, no API key.
# Run Ollama on the host and pull a small model first:
#   brew install ollama && brew services start ollama
#   ollama pull llama3.2:3b      # ~2GB, light; or qwen2.5:7b for better quality
MAYO_LOCAL_LLM_URL=http://localhost:11434
MAYO_LOCAL_LLM_MODEL=llama3.2:3b
MAYO_LOCAL_LLM_TIMEOUT=120

# --- Pointers only (values injected at runtime, not stored here) ---
# AI provider API keys (image + video model providers)
# MAYO_PROVIDER_<NAME>_KEY=<in host .env / secret store>
# Object storage credentials (Phase 2, when MAYO_STORAGE_BACKEND=s3)
# MAYO_S3_ENDPOINT / MAYO_S3_BUCKET / MAYO_S3_KEY / MAYO_S3_SECRET=<in secret store>
# YouTube Data API OAuth2 client (per-user publish)
# MAYO_YOUTUBE_CLIENT_ID / MAYO_YOUTUBE_CLIENT_SECRET=<in secret store>
