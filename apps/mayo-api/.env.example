# Mayo API configuration — copy to .env and fill locally. NEVER commit real
# secret values (see repo CLAUDE.md security rule). This file lists names only.

# dev | prod
MAYO_ENV=dev

# local | s3  (ADR 0004 — local first, s3 later)
MAYO_STORAGE_BACKEND=local
MAYO_STORAGE_LOCAL_PATH=./media

# CORS: comma-separated origins for the Expo app / mayo.im web. "*" ok in dev.
MAYO_ALLOWED_ORIGINS=*

# Shared API key required on all /v1/* endpoints. REQUIRED when the API is
# publicly reachable (e.g. via the Cloudflare tunnel). Generate a random value,
# e.g.  openssl rand -hex 32  — put the SAME value in the app (Account -> API key,
# or EXPO_PUBLIC_MAYO_API_KEY). Never commit the value.
MAYO_API_KEY=<in host .env / secret store>

# Mock generation cadence (seconds per scene tick). Lower = faster demo.
MAYO_TICK_SECONDS=1.0

# Generation backend: mock (timed stand-in) | comfy (local ComfyUI, ADR 0009) |
# external (paid providers: Nano Banana + Higgsfield, ADR 0010).
MAYO_GENERATION_BACKEND=mock

# --- External paid generation (MAYO_GENERATION_BACKEND=external, ADR 0010) ---
# Image stage: Nano Banana = Google Gemini 2.5 Flash Image (REST generateContent).
# GEMINI_API_KEY=<in host .env / secret store>     # aistudio.google.com/apikey
MAYO_NANO_BANANA_MODEL=gemini-2.5-flash-image
MAYO_EXTERNAL_ASPECT_RATIO=16:9
# Set false to skip the image stage and run Higgsfield text->video from the prompt.
MAYO_EXTERNAL_USE_IMAGE_STAGE=true
# Video stage: Higgsfield (official `higgsfield-client` SDK; cloud.higgsfield.ai).
# HF_KEY=<id>:<secret>                              # value at runtime; never commit
# Model id + submit() argument keys are config-driven — set them to match the
# Higgsfield model you use (see its API docs), no code change needed.
MAYO_HIGGSFIELD_MODEL=higgsfield/dop/image-to-video
MAYO_HIGGSFIELD_PROMPT_ARG=prompt
MAYO_HIGGSFIELD_IMAGE_ARG=input_image
MAYO_HIGGSFIELD_POLL_SECONDS=3
MAYO_HIGGSFIELD_MAX_WAIT=600

# Scenario planner / "AI director" (ADR 0008): mock | claude | local
#   mock  = free, offline, rule-based stand-in (no real AI) — default
#   local = free, real AI via a local LLM (Ollama) — no paid key, see below
#   claude= best quality, needs a paid ANTHROPIC_API_KEY
MAYO_PLANNER_BACKEND=mock
# Director LLM when planner=claude (an id from GET /v1/catalog/directors)
MAYO_DIRECTOR_MODEL=claude-opus-4-8
# Claude credentials for the director (value at runtime; never commit)
# ANTHROPIC_API_KEY=<in host .env / secret store>   # or use `ant auth login`

# Local LLM director (used when MAYO_PLANNER_BACKEND=local) — free, no API key.
# Run Ollama on the host and pull a small model first:
#   brew install ollama && brew services start ollama
#   ollama pull llama3.2:3b      # ~2GB, light; or qwen2.5:7b for better quality
MAYO_LOCAL_LLM_URL=http://localhost:11434
MAYO_LOCAL_LLM_MODEL=llama3.2:3b
MAYO_LOCAL_LLM_TIMEOUT=120

# --- Pointers only (values injected at runtime, not stored here) ---
# AI provider keys are listed in their sections above (GEMINI_API_KEY, HF_KEY,
# ANTHROPIC_API_KEY) — names only here; real values live in the host secret store.
# Object storage credentials (Phase 2, when MAYO_STORAGE_BACKEND=s3)
# MAYO_S3_ENDPOINT / MAYO_S3_BUCKET / MAYO_S3_KEY / MAYO_S3_SECRET=<in secret store>
# YouTube Data API OAuth2 client (per-user publish)
# MAYO_YOUTUBE_CLIENT_ID / MAYO_YOUTUBE_CLIENT_SECRET=<in secret store>

# --- Accounts / SNS login ---
# Google OAuth client id(s) whose id_tokens the API accepts (comma-separated:
# web + iOS + Android clients each have their own). Client ids are not secret
# but are environment-specific; create them in Google Cloud Console.
# GOOGLE_OAUTH_CLIENT_IDS=<web-id>.apps.googleusercontent.com,<ios-id>.apps.googleusercontent.com

# GitHub sign-in: register an OAuth app (github.com/settings/developers) with
# the Authorization callback URL below, then set its id/secret on the host.
# GITHUB_OAUTH_CLIENT_ID=<in host .env / secret store>
# GITHUB_OAUTH_CLIENT_SECRET=<in host .env / secret store>
# GITHUB_OAUTH_REDIRECT_URI=https://mayo-api.efforthye.dev/v1/auth/github/callback

# Apple sign-in: id_token audiences the API accepts (comma-separated). Expo Go
# tokens carry Apple's own bundle id; add the app's bundle id for a standalone
# build. Needs PyJWT[crypto] (requirements.txt).
# APPLE_OAUTH_AUDIENCES=host.exp.Exponent

# --- Stripe card payments (web/mayo.im plans, ADR 0012) ---
# Secret key + webhook signing secret from the Stripe dashboard; price ids map
# plans to Stripe Prices. Values live in the host secret store, never the repo.
# STRIPE_SECRET_KEY=<in host .env / secret store>
# STRIPE_WEBHOOK_SECRET=<in host .env / secret store>
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_STUDIO=price_...
MAYO_CHECKOUT_SUCCESS_URL=https://mayo.im/plan?checkout=success
MAYO_CHECKOUT_CANCEL_URL=https://mayo.im/plan?checkout=cancel

# Gate premium backends (Claude director, external generation) behind a paid
# plan. true (default) = paid or admin only; false = open dev mode.
MAYO_PREMIUM_GATING=true

# Admin accounts (comma-separated emails) — /v1/admin access + premium bypass.
MAYO_ADMIN_EMAILS=you@example.com

# Outbound mail for password-reset codes. Unset host -> reset endpoints answer
# 501 honestly. Gmail: smtp.gmail.com:587 + an App Password (not the account
# password). Values live only in the host .env — never commit them.
MAYO_SMTP_HOST=
MAYO_SMTP_PORT=587
MAYO_SMTP_USER=
MAYO_SMTP_PASS=
MAYO_SMTP_FROM=
