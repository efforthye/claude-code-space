# Copy to .env.local for local dev; set the same names in Vercel → Project → Environment Variables.
# Values never go in the repo. NEXT_PUBLIC_* ends up in the browser bundle.

NEXT_PUBLIC_SITE_URL=https://mayo.im

# 무통장 입금 계좌 (주문 완료 화면에만 표시)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=

# 사이버몰 운영자 표시 (전자상거래법) — 비우면 "등록 예정"
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ART_SERVICE_NO=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# 관리자 로그인 — 긴 무작위 문자열 (openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 개발용 예시 데이터 끄기: off
MAYO_SAMPLE_DATA=

# 장소 검색 (카카오 로컬 REST 키, 서버 전용). 비우면 우편번호 서비스로 대신 찾는다
KAKAO_REST_API_KEY=

# MongoDB Atlas (Creiip / mayo / Cluster0). 있으면 회원, 주문, 신청이 DB에 저장된다. 테스트는 MAYO_DATA_DIR로 파일 저장소를 쓴다.
# 값은 Vercel 환경변수와 .env.local에만. Production은 mayo, Preview는 mayo-preview, 로컬은 mayo-dev.
MONGODB_URI=
MONGODB_DB=
