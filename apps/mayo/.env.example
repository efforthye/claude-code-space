# Copy to .env.local for local overrides. Expo inlines EXPO_PUBLIC_* at build time.

# Base URL of the mayo-api backend the app talks to. Defaults (in code) to the
# stable Cloudflare-tunnel address, which works from anywhere over HTTPS. Set
# this to override at build time; you can also change it at runtime in the app
# (Account → Server), e.g. http://localhost:8001 when running on the mini.
EXPO_PUBLIC_MAYO_API_URL=https://mayo-api.efforthye.dev

# API key sent to the backend (Authorization: Bearer). Must match the server's
# MAYO_API_KEY. It's a secret — do NOT commit a real value here; set it at build
# time, or paste it once at runtime in the app (Account → API key).
EXPO_PUBLIC_MAYO_API_KEY=
