# Copy to infra/elk/.env ON THE MINI and fill in. `.env` is gitignored —
# never commit the real values.
#
# Generate the passwords, don't invent them:
#   openssl rand -base64 24

STACK_VERSION=9.4.4

# Superuser for Elasticsearch. Filebeat also authenticates with this.
ELASTIC_PASSWORD=<generate>

# Internal account Kibana uses to talk to Elasticsearch. Different value.
KIBANA_PASSWORD=<generate>

# Where the launchd agents write their logs on the mini.
HOST_LOG_DIR=/Users/<mini-user>/Library/Logs

# --- Memory ------------------------------------------------------------
# Sized for the mini: a 5.77 GiB Docker VM that already holds Jenkins
# (~1.1 GiB) and richclub (~0.6 GiB), on a 16 GB host that ALSO runs ComfyUI
# outside Docker. Total here is ~2 GiB, which leaves headroom for Jenkins
# builds. Do NOT raise the Docker VM to make room — ComfyUI needs that RAM.
#
# On a machine with room to spare: ES_HEAP=1g, ES_MEM_LIMIT=2g,
# KIBANA_MEM_LIMIT=1200m.
# ES_MEM_LIMIT must be well above ES_HEAP: the JVM heap is only part of what
# Elasticsearch uses (Lucene mappings, direct buffers, page cache). At a 1g
# limit with a 512m heap it sat at 98% on the mini and was one spike from OOM.
ES_HEAP=512m
ES_MEM_LIMIT=1500m
KIBANA_MEM_LIMIT=1g
# Keep the Node heap below KIBANA_MEM_LIMIT, in MB.
KIBANA_NODE_HEAP=700
