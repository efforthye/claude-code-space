<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static routes only. Published reels are dynamic and cannot be enumerated at
  build time — they need a generated sitemap served from the API
  (/v1/public/sitemap.xml) and a rewrite in vercel.json. Until that exists,
  individual reels are discoverable through the feed and shared links, not here.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.mayo.im/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.mayo.im/reels</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://www.mayo.im/plan</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
