# Never commit secrets — the wiki records pointers to secrets, never values.
.env
.env.*
*.env
# …but DO track the names-only templates (no secret values in these).
!.env.example
!**/.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
*_rsa
*_ed25519
secrets/
*.secret
credentials*.json
*token*.txt

# Terraform — state stores provider values (incl. container env) in PLAINTEXT.
# Never commit state, tfvars, or the generated import IDs.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
infra/terraform/onprem/imports.generated.tf

# OS / editor noise
.DS_Store
Thumbs.db
.obsidian/workspace*
.idea/
.vscode/

# Local scratch
*.tmp
*.log

# App build artifacts under apps/ (commit source only)
node_modules/
apps/**/node_modules/
.expo/
apps/**/.expo/
.expo-shared/
dist/
web-build/
apps/**/dist/
apps/**/.expo-shared/
# Flutter / Dart build artifacts (commit source only)
apps/**/.dart_tool/
apps/**/build/
apps/**/.flutter-plugins
apps/**/.flutter-plugins-dependencies
apps/**/.packages
apps/**/pubspec.lock.bak

# Expo / React Native / native build junk
*.jks
*.keystore
apps/**/ios/Pods/
apps/**/android/.gradle/
apps/**/android/app/build/
apps/**/ios/build/
