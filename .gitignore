# Never commit secrets — the wiki records pointers to secrets, never values.
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
*_rsa
*_ed25519
secrets/
*.secret
credentials*.json
*token*.txt

# OS / editor noise
.DS_Store
Thumbs.db
.obsidian/workspace*
.idea/
.vscode/

# Local scratch
*.tmp
*.log

# App build artifacts under apps/ (commit source only)
node_modules/
apps/**/node_modules/
.expo/
apps/**/.expo/
.expo-shared/
dist/
web-build/
apps/**/dist/
apps/**/.expo-shared/
# Expo / React Native / native build junk
*.jks
*.keystore
apps/**/ios/Pods/
apps/**/android/.gradle/
apps/**/android/app/build/
apps/**/ios/build/
